{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virtengine.com/schemas/prototype-integration/slurm-chart-inventory.schema.json",
  "title": "VirtEngine SLURM chart convergence inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checkpoint",
    "status",
    "validation_mode",
    "research_scope",
    "canonical_source",
    "compatibility_import_only_shims",
    "retired_sources",
    "semantic_validator",
    "semantic_report",
    "semantic_invariants",
    "dependencies",
    "blockers",
    "completion"
  ],
  "properties": {
    "schema_version": { "const": "virtengine.prototype.slurm-chart-inventory/v2" },
    "checkpoint": { "const": "T4-07F" },
    "status": { "enum": ["blocked", "complete"] },
    "validation_mode": { "enum": ["contract-only", "executable-semantic", "semantic-render"] },
    "research_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roots", "selection_evidence", "non_chart_hpc_sources"],
      "properties": {
        "roots": {
          "type": "array",
          "const": ["deploy", "infra", "config", "charts", "scripts", "_build/helm"]
        },
        "selection_evidence": { "$ref": "#/$defs/nonEmptyStrings" },
        "non_chart_hpc_sources": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "canonical_source": { "$ref": "#/$defs/source" },
    "compatibility_import_only_shims": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" },
      "uniqueItems": true
    },
    "retired_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/source" },
          {
            "type": "object",
            "properties": {
              "state": { "enum": ["present-blocker", "absent-forbidden"] },
              "allowed_use": { "const": "none" }
            }
          }
        ]
      }
    },
    "semantic_validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "implementation", "test", "testdata", "passing_command", "diagnostic_command", "production_result"],
      "properties": {
        "contract": { "const": "virtengine.slurm-semantic-validation/v1" },
        "implementation": { "const": "scripts/validate_slurm_chart_semantics.py" },
        "test": { "const": "scripts/validate_slurm_chart_semantics_test.py" },
        "testdata": { "const": "scripts/testdata/slurm-chart-semantics" },
        "passing_command": { "const": "python scripts/validate_slurm_chart_semantics_test.py -v" },
        "diagnostic_command": { "const": "python scripts/validate_slurm_chart_semantics.py --chart deploy/slurm/slurm-cluster --diagnostic --json" },
        "production_result": { "const": "blocked" }
      }
    },
    "semantic_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "source", "generated_by"],
      "properties": {
        "path": { "const": "_docs/ralph/prototype-integration/slurm-chart-semantic-report.json" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source": { "const": "deploy/slurm/slurm-cluster" },
        "generated_by": { "const": "python scripts/validate_slurm_chart_semantics.py --chart deploy/slurm/slurm-cluster --diagnostic --json" }
      }
    },
    "semantic_invariants": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/invariant" }
    },
    "dependencies": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "reason"],
        "properties": {
          "id": { "enum": ["84B", "84C", "85C", "87A", "87D"] },
          "status": { "enum": ["unverified", "ready"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "blockers": { "$ref": "#/$defs/nonEmptyStrings" },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "required_evidence"],
      "properties": {
        "allowed": { "type": "boolean" },
        "required_evidence": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "state", "allowed_use", "evidence"],
      "properties": {
        "path": { "type": "string", "pattern": "^[^\\\\]+$" },
        "kind": { "const": "helm-chart" },
        "state": { "type": "string", "minLength": 1 },
        "allowed_use": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "requirement", "evidence", "blocker"],
      "properties": {
        "id": {
          "enum": [
            "stable-secrets",
            "replica-capacity-equality",
            "immutable-images",
            "least-privilege",
            "durable-state"
          ]
        },
        "status": { "enum": ["violated", "unverified", "satisfied"] },
        "requirement": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/nonEmptyStrings" },
        "blocker": { "type": ["string", "null"] }
      }
    }
  }
}