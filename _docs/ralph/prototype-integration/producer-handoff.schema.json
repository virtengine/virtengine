{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virtengine.example/schemas/prototype-producer-handoff-v2.json",
  "title": "VirtEngine prototype producer intake v2 handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaign",
    "thread",
    "checkpoint",
    "branch",
    "frozen_baseline",
    "planning_sha",
    "intake_epoch",
    "intake_base_sha",
    "payload_head",
    "prior_accepted_payload",
    "tree_clean",
    "commits_since_prior_acceptance",
    "owned_paths",
    "files_changed",
    "tests",
    "generated_hashes",
    "migrations",
    "external_evidence",
    "known_failures",
    "blockers",
    "next_checkpoint"
  ],
  "properties": {
    "campaign": { "const": "three-day-prototype" },
    "thread": { "enum": ["T1", "T2", "T3", "T5"] },
    "checkpoint": { "type": "string", "pattern": "^T[1235]-[0-9]{2,}[A-Z]?$" },
    "branch": { "enum": ["ve/prototype-t1-identity", "ve/prototype-t2-product", "ve/prototype-t3-reliability", "ve/prototype-t5-platform"] },
    "frozen_baseline": { "const": "79391a3df86d85522b92e0400c6904971ecbe65d" },
    "planning_sha": { "$ref": "#/$defs/sha" },
    "intake_epoch": { "type": "integer", "minimum": 1 },
    "intake_base_sha": { "$ref": "#/$defs/sha" },
    "payload_head": { "$ref": "#/$defs/sha" },
    "prior_accepted_payload": { "oneOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] },
    "tree_clean": { "const": true },
    "commits_since_prior_acceptance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sha" }, "uniqueItems": true },
    "owned_paths": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/path" }, "uniqueItems": true },
    "files_changed": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/path" }, "uniqueItems": true },
    "tests": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/testResult" } },
    "generated_hashes": { "type": "object", "propertyNames": { "$ref": "#/$defs/path" }, "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "migrations": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true },
    "external_evidence": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true },
    "known_failures": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "next_checkpoint": { "type": ["string", "null"], "pattern": "^T[1235]-[0-9]{2,}[A-Z]?$" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)" },
    "testResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code", "result", "tool_versions", "artifact"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "exit_code": { "const": 0 },
        "result": { "const": "passed" },
        "test_count": { "type": "integer", "minimum": 1 },
        "tool_versions": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
        "artifact": { "$ref": "#/$defs/path" }
      }
    }
  }
}