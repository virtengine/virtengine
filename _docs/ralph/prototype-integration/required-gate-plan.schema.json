{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virtengine.com/schemas/prototype-integration/required-gate-plan.schema.json",
  "title": "T4-05B deterministic required-gate execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base_sha", "head_sha", "matrix_digest", "matrix_status", "changed_paths", "allowlisted_paths", "categories"],
  "properties": {
    "schema_version": { "const": "virtengine.task-88b.required-gate-plan/v1" },
    "base_sha": { "$ref": "#/$defs/sha" },
    "head_sha": { "$ref": "#/$defs/sha" },
    "matrix_digest": { "$ref": "#/$defs/digest" },
    "matrix_status": { "enum": ["dependency_blocked", "ready", "complete"] },
    "changed_paths": { "$ref": "#/$defs/uniqueStrings" },
    "allowlisted_paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/allowlistedPath" } },
    "categories": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/category" } }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "uniqueStrings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "allowlistedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "selector", "reason"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "selector": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "command"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
        "kind": { "enum": ["setup", "build", "lint", "test", "policy", "drift"] },
        "command": { "type": "string", "minLength": 1 }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$" },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]+[A-Z]?$" },
        "status": { "enum": ["unavailable", "available"] }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "matched_paths", "matched_selectors", "commands", "pinned_tools", "dependencies", "blockers"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "status": { "enum": ["dependency_blocked", "ready", "complete"] },
        "matched_paths": { "$ref": "#/$defs/uniqueStrings" },
        "matched_selectors": { "$ref": "#/$defs/uniqueStrings" },
        "commands": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/command" } },
        "pinned_tools": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/tool" } },
        "dependencies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/dependency" } },
        "blockers": { "$ref": "#/$defs/uniqueStrings" }
      }
    }
  }
}