# VirtEngine Identity Verification Pipeline - Deterministic Container
# VE-219: Deterministic identity verification runtime
#
# This Dockerfile builds a pinned, deterministic OCI image for the identity
# verification pipeline used by VirtEngine validators. All validators MUST
# run the exact same image version to ensure consensus.
#
# IMPORTANT: This image is designed for CPU-only deterministic execution.
# GPU execution is explicitly disabled to ensure reproducible results.
#
# Build: docker build -f Dockerfile.veid-pipeline -t ghcr.io/virtengine/veid-pipeline:v1.0.0 .
# Verify: docker inspect --format='{{.Id}}' ghcr.io/virtengine/veid-pipeline:v1.0.0

# =============================================================================
# Stage 1: Base Image with Pinned Dependencies
# =============================================================================
FROM python:3.11.7-slim-bookworm@sha256:53d6284a40eae6b625f22870f5faba6c54f2a28db9027408f4dee111f1e885a2 AS base

LABEL org.opencontainers.image.title="VirtEngine VEID Pipeline"
LABEL org.opencontainers.image.description="Deterministic identity verification pipeline for VirtEngine validators"
LABEL org.opencontainers.image.vendor="VirtEngine"
LABEL org.opencontainers.image.source="https://github.com/virtengine-network/node"
LABEL org.virtengine.pipeline.version="1.0.0"
LABEL org.virtengine.deterministic="true"

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Determinism settings - CRITICAL for consensus
ENV TF_DETERMINISTIC_OPS=1
ENV TF_CUDNN_DETERMINISTIC=1
ENV TF_USE_CUDNN_AUTOTUNE=0
ENV TF_ENABLE_ONEDNN_OPTS=0
ENV TF_CPP_MIN_LOG_LEVEL=2
ENV TF_FORCE_GPU_ALLOW_GROWTH=false
ENV TF_XLA_FLAGS="--tf_xla_auto_jit=-1"
ENV PYTHONHASHSEED=42
ENV OMP_NUM_THREADS=1
ENV MKL_NUM_THREADS=1
ENV OPENBLAS_NUM_THREADS=1
ENV NUMEXPR_NUM_THREADS=1
ENV CUDA_VISIBLE_DEVICES=-1

# Install system dependencies with exact versions.
# NOTE (2026-09-22): pins track Debian bookworm point releases; when a
# point release supersedes a pin, apt fails with "Version X was not found"
# (previously libgomp1 12.2.0-14, libglib2.0-0 +deb12u2). Refresh pins from
# http://deb.debian.org/debian/dists/bookworm/main/binary-amd64/Packages.gz
# (bookworm-security carries none of these; bookworm main is authoritative).
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Tesseract OCR with exact version
    tesseract-ocr=5.3.0-2 \
    tesseract-ocr-eng=1:4.1.0-2 \
    # Image processing libraries
    libglib2.0-0=2.74.6-2+deb12u9 \
    libsm6=2:1.2.3-1 \
    libxext6=2:1.3.4-1+b1 \
    libxrender1=1:0.9.10-1.1 \
    libgl1=1.6.0-1 \
    libgomp1=12.2.0-14+deb12u1 \
    # Cleanup
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# Stage 2: Python Dependencies with Exact Versions
# =============================================================================
FROM base AS python-deps

WORKDIR /app

VOLUME ["/tmp"]

# Copy requirements file with pinned versions
COPY ml/requirements-deterministic.txt requirements.txt

# Install Python dependencies with exact versions
# Using --no-cache-dir and --no-compile for reproducibility
RUN pip install --no-cache-dir --no-compile -r requirements.txt

# =============================================================================
# Stage 3: Model Weights
# =============================================================================
FROM python-deps AS models

WORKDIR /app/models

# Create model directories, then record why the image ships code only.
# Model weights are NOT baked into the image: they are produced by
# ml/training (see models/trust_score) and validated by
# _build/build-veid-pipeline.sh, then mounted at /app/models at deploy time.
# (Previously this stage COPYd ml/models/*.h5/*.pth/*.json, which were never
# committed, so the image never built.)
RUN mkdir -p deepface craft unet tesseract identity_scorer \
    && printf '{\n  "schema": "veid.models.config/v1",\n  "note": "code-only image: weights mounted at /app/models at deploy time; validate with python3 -m ml.pipeline_runner --mode=check",\n  "pipeline_version": "1.0.0"\n}\n' > config.json

# =============================================================================
# Stage 4: Application Code
# =============================================================================
FROM models AS app

WORKDIR /app

# Copy ML pipeline code
COPY ml/document_preprocessing/ ml/document_preprocessing/
COPY ml/face_extraction/ ml/face_extraction/
COPY ml/facial_verification/ ml/facial_verification/
COPY ml/ocr_extraction/ ml/ocr_extraction/
COPY ml/text_detection/ ml/text_detection/
COPY ml/training/ ml/training/

# Copy pipeline runner
COPY ml/pipeline_runner.py ml/pipeline_runner.py
COPY ml/__init__.py ml/__init__.py

# Copy inference gRPC contract. (The Go sidecar client,
# pkg/inference/sidecar.go, is not part of this Python image; the
# previously referenced pkg/inference/sidecar/ directory never existed.)
COPY pkg/inference/proto/inference.proto pkg/inference/proto/inference.proto

# =============================================================================
# Stage 5: Final Image
# =============================================================================
# =============================================================================
# Stage 5: Final Image — patchable Debian base (NOT distroless)
# =============================================================================
# 2026-09-27 (test-guard t_cf61c696): the previous final stage was
# gcr.io/distroless/python3-debian12. Its OS packages (libssl3, libexpat1,
# libpython3.11, krb5) carried 19 HIGH CVEs with fixes available upstream, but
# distroless published no newer digest, so no digest bump could clear the
# Container Vulnerability Scan gate — and the image could never be patched
# in-repo either (distroless ships no apt toolchain). Worse, the old
# runtime-deps overlay copied 2024-vintage .so files over distroless's own
# libraries with no dpkg metadata, so Trivy was blind to them. This stage is
# therefore a current python:3.11-slim-bookworm digest plus `apt-get upgrade`
# (same pattern as Dockerfile.virtengine's `apk upgrade`): the dpkg database
# Trivy scans is one this repo owns and patches, and the libssl3/libexpat1
# the app loads are the same upgraded files Trivy reports on.
FROM python:3.11-slim-bookworm@sha256:a36c24f9cbdf4fd0f52d67f0823eeac19c2028c637cecc392d97f980d4fec56b AS final

# Determinism settings — MUST mirror Stage 1. ENV does not cross FROM
# boundaries, so these are repeated here: the old distroless final stage
# never carried them, which failed both _build/build-veid-pipeline.sh
# verify_image (printenv TF_DETERMINISTIC_OPS / CUDA_VISIBLE_DEVICES) and the
# REQUIRED_DETERMINISM_ENV gate in ml/pipeline_runner.py at sidecar startup.
ENV TF_DETERMINISTIC_OPS=1
ENV TF_CUDNN_DETERMINISTIC=1
ENV TF_USE_CUDNN_AUTOTUNE=0
ENV TF_ENABLE_ONEDNN_OPTS=0
ENV TF_CPP_MIN_LOG_LEVEL=2
ENV TF_FORCE_GPU_ALLOW_GROWTH=false
ENV TF_XLA_FLAGS="--tf_xla_auto_jit=-1"
ENV PYTHONHASHSEED=42
ENV OMP_NUM_THREADS=1
ENV MKL_NUM_THREADS=1
ENV OPENBLAS_NUM_THREADS=1
ENV NUMEXPR_NUM_THREADS=1
ENV CUDA_VISIBLE_DEVICES=-1

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV HOME=/app

# Patch the OS layer we ship, then install the OCR/OpenCV runtime libraries
# the pipeline needs (same set the old runtime-deps stage harvested from
# `base`, now installed fresh so versions match the dpkg database Trivy
# scans). Installs are intentionally unpinned: `upgrade` already moves every
# package to its latest bookworm revision, and a pin here would fight it
# (apt would DOWNGRADE to the pin). Reproducibility comes from the base
# digest pin above plus the single published image digest validators run —
# same tradeoff as Dockerfile.virtengine's `apk upgrade`.
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-eng \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgl1 \
    libgomp1 \
    libpng16-16 \
    libjpeg62-turbo \
    libtiff6 \
    libwebp7 \
    libopenjp2-7 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r nonroot --gid 65532 \
    && useradd -r -u 65532 -g nonroot -d /app -s /usr/sbin/nologin nonroot \
    && mkdir -p /app && chown nonroot:nonroot /app

WORKDIR /app

# Only the pip site-packages and the app code travel forward. Deliberately NOT
# /usr/local/bin or /usr/local/lib/python3.11 from python-deps: those are
# CPython 3.11.7 (Jan 2024) with the same class of fixed-upstream CVEs, but
# outside any dpkg database Trivy scans — copying them would reintroduce the
# exact invisible-staleness this change removes. The final stage's own
# interpreter (same 3.11 minor, ABI-compatible) runs the carried
# site-packages; ENTRYPOINT resolves to its /usr/local/bin/python3.
COPY --from=python-deps /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=app --chown=nonroot:nonroot /app /app

USER nonroot

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ["python3", "-c", "import ml.pipeline_runner; print('healthy')"]

# Expose gRPC port for sidecar communication
EXPOSE 50051

# Default entrypoint runs the inference sidecar
ENTRYPOINT ["python3", "-m", "ml.pipeline_runner"]
CMD ["--mode=sidecar", "--port=50051", "--deterministic=true"]
