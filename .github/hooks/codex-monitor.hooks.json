{
  "version": 1,
  "sessionStart": [
    {
      "type": "command",
      "command": [
        "node",
        "-e",
        "process.exit(0)"
      ],
      "timeout": 60
    }
  ],
  "sessionEnd": [
    {
      "type": "command",
      "command": [
        "node",
        "-e",
        "process.exit(0)"
      ],
      "timeout": 60
    }
  ],
  "preToolUse": {
    "*": [
      {
        "type": "command",
        "command": [
          "node",
          "-e",
          "process.exit(0)"
        ],
        "timeout": 300
      }
    ]
  },
  "postToolUse": {
    "*": [
      {
        "type": "command",
        "command": [
          "node",
          "-e",
          "process.exit(0)"
        ],
        "timeout": 120
      }
    ]
  }
}
