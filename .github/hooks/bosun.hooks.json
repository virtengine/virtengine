{
  "version": 1,
  "sessionStart": [
    {
      "type": "command",
      "command": [
        "sh",
        "-c",
        "exit 0"
      ],
      "timeout": 60
    }
  ],
  "sessionEnd": [
    {
      "type": "command",
      "command": [
        "sh",
        "-c",
        "exit 0"
      ],
      "timeout": 60
    }
  ],
  "preToolUse": {
    "*": [
      {
        "type": "command",
        "command": [
          "sh",
          "-c",
          "exit 0"
        ],
        "timeout": 300
      }
    ]
  },
  "postToolUse": {
    "*": [
      {
        "type": "command",
        "command": [
          "sh",
          "-c",
          "exit 0"
        ],
        "timeout": 120
      }
    ]
  }
}
